<?xml version="1.0" encoding="UTF-8"?>
<Patch>
    <!--
    Possible Locations
    <snowOverlayGraphicPath>TKKN_NPS/Plant_Brambles</snowOverlayGraphicPath>
    <leaflessSnowOverlayGraphicPath>TKKN_NPS/Plant_Brambles</leaflessSnowOverlayGraphicPath>
    <immatureSnowOverlayGraphicPath>TKKN_NPS/Plant_Brambles</immatureSnowOverlayGraphicPath>
    
    LazyPatchOp cause I was lazy and didn't know what to call it.
    It's a conditional, it will only be ran if the setting to overwrite base game tree textures is active. 
    Otherwise, it does nothing
    -->
    <Operation Class="MoreSnowTrees.LazyPatchOp">
        <xpath>Defs/ThingDef[defName = "Plant_Brambles"]/plant/Leafless/leaflessSnowOverlayGraphicPath</xpath>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName = "Plant_Brambles"]/plant</xpath>
            <value>
                <leaflessSnowOverlayGraphicPath>TKKN_NPS/Leafless/Plant_Brambles</leaflessSnowOverlayGraphicPath>
            </value>
        </nomatch>
        <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName = "Plant_Brambles"]/plant/Leafless/leaflessSnowOverlayGraphicPath</xpath>
            <value>
                <leaflessSnowOverlayGraphicPath>TKKN_NPS/Leafless/Plant_Brambles</leaflessSnowOverlayGraphicPath>
            </value>
        </match>
    </Operation>

